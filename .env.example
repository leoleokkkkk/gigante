# ==============================================================================
# GIGANTE MULTIMARCAS — VARIÁVEIS DE AMBIENTE (SUPABASE & NEXT.JS)
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto
# ==============================================================================

# SUPABASE CLIENT (Obtido em: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"

# SUPABASE POSTGRESQL DATABASE URL (Obtido em: Project Settings > Database)
# Modo Pooler (Transaction - Porta 6543) - Recomendado para Next.js / Serverless
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Modo Direto (Porta 5432) - Necessário para migrações do Prisma
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# MODO DONO (Senha padrão da loja se não configurado no banco)
ADMIN_PASSWORD="giganteadmin"
