// This is your Prisma schema file for Gigante Multimarcas
// Duplication & Portability Schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  image         String?
  itemCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id         String    @id @default(uuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  createdAt  DateTime  @default(now())
  products   Product[]

  @@map("subcategories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]

  @@map("brands")
}

model Product {
  id               String               @id @default(uuid())
  name             String
  slug             String               @unique
  description      String
  shortDescription String?
  categoryId       String
  category         Category             @relation(fields: [categoryId], references: [id])
  subcategoryId    String?
  subcategory      Subcategory?         @relation(fields: [subcategoryId], references: [id])
  brandId          String
  brand            Brand                @relation(fields: [brandId], references: [id])
  baseSku          String               @unique
  barcode          String?
  costPrice        Decimal              @default(0.00) @db.Decimal(10, 2)
  sellingPrice     Decimal              @default(0.00) @db.Decimal(10, 2)
  promoPrice       Decimal?             @db.Decimal(10, 2)
  weightKg         Decimal              @default(0.800) @db.Decimal(8, 3)
  heightCm         Int                  @default(12)
  widthCm          Int                  @default(20)
  lengthCm         Int                  @default(30)
  status           String               @default("active")
  isNew            Boolean              @default(false)
  isFeatured       Boolean              @default(false)
  isBestSeller     Boolean              @default(false)
  gender           String               @default("unissex")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  movements        InventoryMovement[]

  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  isPrimary   Boolean  @default(false)
  isSecondary Boolean  @default(false)
  sortOrder   Int      @default(0)

  @@map("product_images")
}

model ProductVariant {
  id           String              @id @default(uuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String              @unique
  barcode      String
  size         String
  color        String
  stock        Int                 @default(0)
  minStock     Int                 @default(2)
  costPrice    Decimal             @default(0.00) @db.Decimal(10, 2)
  sellingPrice Decimal             @default(0.00) @db.Decimal(10, 2)
  location     String?             @default("Prateleira A1")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  orderItems   OrderItem[]
  movements    InventoryMovement[]

  @@map("product_variants")
}

model Customer {
  id          String            @id @default(uuid())
  name        String
  email       String            @unique
  phone       String
  document    String
  createdAt   DateTime          @default(now())
  totalOrders Int               @default(0)
  totalSpent  Decimal           @default(0.00) @db.Decimal(10, 2)
  notes       String?
  addresses   CustomerAddress[]
  orders      Order[]
  returns     Return[]

  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean  @default(true)

  @@map("customer_addresses")
}

model CashRegister {
  id               String                 @id @default(uuid())
  openedAt         DateTime               @default(now())
  closedAt         DateTime?
  openedBy         String
  closedBy         String?
  initialBalance   Decimal                @default(0.00) @db.Decimal(10, 2)
  currentBalance   Decimal                @default(0.00) @db.Decimal(10, 2)
  totalCash        Decimal                @default(0.00) @db.Decimal(10, 2)
  totalCreditCard  Decimal                @default(0.00) @db.Decimal(10, 2)
  totalDebitCard   Decimal                @default(0.00) @db.Decimal(10, 2)
  totalPix         Decimal                @default(0.00) @db.Decimal(10, 2)
  totalBleed       Decimal                @default(0.00) @db.Decimal(10, 2)
  totalDeposit     Decimal                @default(0.00) @db.Decimal(10, 2)
  status           String                 @default("open")
  notes            String?
  movements        CashMovement[]
  orders           Order[]
  transactions     FinancialTransaction[]

  @@map("cash_registers")
}

model CashMovement {
  id             String       @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  type           String
  amount         Decimal      @db.Decimal(10, 2)
  reason         String
  performedBy    String
  createdAt      DateTime     @default(now())

  @@map("cash_movements")
}

model Order {
  id                   String                 @id @default(uuid())
  orderNumber          String                 @unique
  channel              String                 @default("online")
  customerId           String?
  customer             Customer?              @relation(fields: [customerId], references: [id])
  customerName         String
  customerEmail        String
  customerPhone        String
  customerDocument     String
  shippingStreet       String?
  shippingNumber       String?
  shippingComplement   String?
  shippingNeighborhood String?
  shippingCity         String?
  shippingState        String?
  shippingZipCode      String?
  subtotal             Decimal                @default(0.00) @db.Decimal(10, 2)
  discount             Decimal                @default(0.00) @db.Decimal(10, 2)
  shippingCost         Decimal                @default(0.00) @db.Decimal(10, 2)
  total                Decimal                @default(0.00) @db.Decimal(10, 2)
  totalCost            Decimal                @default(0.00) @db.Decimal(10, 2)
  profit               Decimal                @default(0.00) @db.Decimal(10, 2)
  status               String                 @default("pending")
  paymentMethod        String
  paymentStatus        String                 @default("pending")
  installments         Int                    @default(1)
  pixCode              String?
  deliveryMethod       String                 @default("correios_pac")
  trackingCode         String?
  estimatedDelivery    DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cashRegisterId       String?
  cashRegister         CashRegister?          @relation(fields: [cashRegisterId], references: [id])
  couponCode           String?
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  items                OrderItem[]
  trackingEvents       OrderTrackingEvent[]
  returns              Return[]
  transactions         FinancialTransaction[]

  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  size        String
  color       String
  sku         String
  barcode     String?
  imageUrl    String?
  unitCost    Decimal        @default(0.00) @db.Decimal(10, 2)
  unitPrice   Decimal        @default(0.00) @db.Decimal(10, 2)
  quantity    Int            @default(1)
  totalCost   Decimal        @default(0.00) @db.Decimal(10, 2)
  totalPrice  Decimal        @default(0.00) @db.Decimal(10, 2)

  @@map("order_items")
}

model OrderTrackingEvent {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  title       String
  description String?
  location    String?
  createdAt   DateTime @default(now())

  @@map("order_tracking_events")
}

model InventoryMovement {
  id            String         @id @default(uuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  type          String
  quantity      Int
  previousStock Int
  newStock      Int
  unitCost      Decimal?       @db.Decimal(10, 2)
  reason        String?
  orderId       String?
  createdBy     String         @default("Sistema")
  createdAt     DateTime       @default(now())

  @@map("inventory_movements")
}

model FinancialTransaction {
  id             String        @id @default(uuid())
  description    String
  type           String
  category       String
  amount         Decimal       @db.Decimal(10, 2)
  status         String        @default("paid")
  paymentMethod  String?
  dueDate        DateTime?
  paidAt         DateTime?
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id])
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])
  notes          String?
  createdAt      DateTime      @default(now())

  @@map("financial_transactions")
}

model Return {
  id                  String   @id @default(uuid())
  returnCode          String   @unique
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id])
  customerId          String?
  customer            Customer?@relation(fields: [customerId], references: [id])
  type                String   @default("exchange")
  reason              String
  status              String   @default("requested")
  reverseTrackingCode String?
  actionTaken         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("returns")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  type          String    @default("percentage")
  value         Decimal   @db.Decimal(10, 2)
  minOrderValue Decimal   @default(0.00) @db.Decimal(10, 2)
  maxDiscount   Decimal?  @db.Decimal(10, 2)
  usageLimit    Int?
  usageCount    Int       @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@map("coupons")
}

model Banner {
  id              String   @id @default(uuid())
  title           String
  subtitle        String?
  badgeText       String?
  imageUrl        String
  mobileImageUrl  String?
  ctaText         String?
  ctaLink         String?
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@map("banners")
}

model StoreSettings {
  id                    String   @id @default("store-default")
  storeName             String   @default("Gigante's Multimarcas")
  tradingName           String?  @default("Gigante Multimarcas Comércio de Calçados LTDA")
  cnpj                  String?  @default("45.892.103/0001-88")
  ie                    String?
  email                 String?  @default("contato@gigantemultimarcas.com.br")
  phone                 String?  @default("(11) 98765-4321")
  whatsapp              String?  @default("5511987654321")
  addressStreet         String?  @default("Av. Paulista")
  addressNumber         String?  @default("1578")
  addressComplement     String?  @default("Loja 12")
  addressNeighborhood   String?  @default("Bela Vista")
  addressCity           String?  @default("São Paulo")
  addressState          String?  @default("SP")
  addressZip            String?  @default("01310-200")
  pixKey                String?  @default("45892103000188")
  pixKeyType            String?  @default("cnpj")
  freeShippingMinAmount Decimal  @default(299.00) @db.Decimal(10, 2)
  correiosOriginZip     String?  @default("01310-200")
  allowPickup           Boolean  @default(true)
  pickupTimeMinutes     Int      @default(120)
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  userName   String
  userRole   String   @default("admin")
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
